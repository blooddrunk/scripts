# ============================================================
# LightLayer 一键下单配置
# 使用方法: cp .env.example .env 然后填写下面各项
# 说明: 系统真实环境变量优先于本文件中的同名值
# ============================================================

# ---- 账号 (必填) ----
LIGHTLAYER_USERNAME=you@example.com
LIGHTLAYER_PASSWORD=your_password

# ---- 下单参数 ----
# 产品 ID (下单必填; 运行 `python3 lightlayer.py products` 可查询)
LIGHTLAYER_PRODUCT_ID=

# 计费周期: m=月付, q=季付, s=半年付, a=年付, b=两年付, t=三年付 (默认 m)
LIGHTLAYER_CYCLE=m

# 支付方式: 填数字 ID 或名称均可 (默认 Alipay)
# - 填数字 ID(如 53): 不调用 /payment 接口, 少一次请求; 仅当下单/试算报错疑似
#   支付方式问题时, 脚本才自动拉取一次支付方式列表辅助排查
# - 填名称(如 Alipay): 每次下单前调用 /payment 接口把名称解析成 ID
# (运行 `python3 lightlayer.py payments` 可查看全部支付方式及其 ID, 如 53=Alipay)
LIGHTLAYER_PAY_METHOD=Alipay

# 优惠码 (可选)
LIGHTLAYER_PROMOCODE=

# 部分产品下单需关联域名时填写 (可选)
LIGHTLAYER_DOMAIN=

# 推广/affiliate ID (可选)
LIGHTLAYER_AFF_ID=

# 产品自定义字段覆盖, JSON 对象格式 {字段id: {item_id: 值}} (可选)
# 下单时脚本会自动按产品表单默认值填写并勾选必选项(如退款政策),
# 此处仅用于覆盖个别字段, 例如把系统换成 Debian12:
#LIGHTLAYER_CUSTOM={"3615": {"32925": 1}}
# 各字段/item id 含义运行 `python3 lightlayer.py forms` 查看

# ---- API 地址 (一般不用改) ----
LIGHTLAYER_API_BASE=https://account.lightlayer.net/api
