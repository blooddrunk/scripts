# ============================================================
# LightLayer 一键下单配置
# 使用方法: cp .env.example .env 然后填写下面各项
# 说明: 系统真实环境变量优先于本文件中的同名值
#       未加引号的值支持行内注释(" #" 之后的内容会被忽略)
# ============================================================

# ---- 账号 (必填) ----
LIGHTLAYER_USERNAME=you@example.com
LIGHTLAYER_PASSWORD=your_password

# 认证模式 (可选; 命令行 --auth 参数优先于本配置, 默认 basic):
# - basic: 每个请求携带 HTTP Basic 认证(官方文档支持)。站点 WAF 按路径拦截
#   POST /api/login, token 认证当前不可用, 故默认 basic(2026-11 实测)。
# - auto : 优先 token(缓存/refresh/login), /login 被 WAF 拦截时自动降级 basic
# - bearer: 仅 token 认证, 被拦即报错(用于检测 WAF 是否已放行 /api/login)
LIGHTLAYER_AUTH=basic

# ---- 下单参数 ----
# 产品 ID (下单必填; 运行 `python3 lightlayer.py products` 可查询)
LIGHTLAYER_PRODUCT_ID=316

# 计费周期: m=月付, q=季付, s=半年付, a=年付, b=两年付, t=三年付 (默认 m)
LIGHTLAYER_CYCLE=m

# 支付方式: 填数字 ID 或名称均可 (默认 Alipay)
# - 填数字 ID(如 53): 不调用 /payment 接口, 少一次请求; 仅当下单/试算报错
#   疑似支付方式问题时, 脚本才自动拉取一次支付方式列表辅助排查
# - 填名称(如 Alipay): 每次下单前调用 /payment 接口把名称解析成 ID
# (运行 `python3 lightlayer.py payments` 查看全部: 7=PayPal 51=Credit Balance 53=Alipay)
LIGHTLAYER_PAY_METHOD=53   # Alipay

# 优惠码 (可选; 部分码仅适用特定产品/周期, 试算报 coupon_not_applicable 即无折扣)
LIGHTLAYER_PROMOCODE=

# 部分产品下单需关联域名时填写 (可选)
LIGHTLAYER_DOMAIN=

# 推广/affiliate ID (可选)
LIGHTLAYER_AFF_ID=1158

# 产品自定义字段覆盖, JSON 对象格式 {字段id: {item_id: 值}} (可选)
# 下单时脚本会按产品表单默认值自动填写并勾选必选项(如退款政策),
# 此处仅用于覆盖个别字段; 各字段/item id 含义运行 `python3 lightlayer.py forms` 查看
# 例: 操作系统选 Debian13 (字段3615=OS Template, item 42152=Debian13)
LIGHTLAYER_CUSTOM={"3615": {"42152": 1}}

# ---- API 地址 (一般不用改) ----
LIGHTLAYER_API_BASE=https://account.lightlayer.net/api
