# ============================================================
# router-home 的 honk 配置（脱敏模板，与 2026-11-20 实际部署一致）
#
# 用法: 复制到路由器 /etc/honk/config.dae 并替换占位符：
#   - 203.0.113.10  -> raksmart 公网 IP
#   - 203.0.113.20  -> lightlayer 公网 IP
#   - 203.0.113.30  -> bitsflow 公网 IP
#   - example.top   -> 自建域名后缀
#   - 订阅 URL       -> Sub-Store 每 VPS 单订阅真实链接（含 token）
#   - clash_api secret -> 随机密钥（勿留空：默认 0.0.0.0 无鉴权暴露）
#
# 设计说明与裁剪决策见同目录 README.md。实装踩坑记录（勿再踩）：
#   1. name('正则') 是全匹配语义；子串过滤必须用 name(keyword: '...')；
#      池身份一律用 subtag(<订阅tag>)，勿依赖节点名
#   2. 订阅必须 route: direct，否则冷启动无节点时订阅下载死锁
#   3. clash_api secret 修改后热 reload 不生效，需 lifecycle restart
#   4. honk:local-direct-begin/end 标记块由 control.sh 按本机地址重写，保留
#   5. config validate 不检查 filter 表达式（写错函数名照样绿灯，运行时静默
#      忽略导致组空）；改 filter 后必看 logread 有无 parse 告警
#   6. group(...) 必须独占整个 filter 行；honk-core proxy 子命令不能选嵌套组
#      成员，脚本切 selector 用 clash API PUT /proxies/<组>
# ============================================================

global {
    wan_interface: auto
    lan_interface: br-lan
    log_level: info
    dial_mode: domain
    allow_insecure: false
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk'
    # 默认只走 logread，由面板日志页读取。需要跨重启排障时再指定持久路径。
    log_file: ''
    # 检测目标与公司侧对齐：cp.cloudflare.com（gstatic 有 geoip:cn 误杀前科）、
    # AliDNS:53（VPS 侧 Xray 有对应的 UDP53 窄例外，见 vps-proxy-rollout/ROUTING.md）
    tcp_check_url: 'http://cp.cloudflare.com'
    tcp_check_http_method: HEAD
    udp_check_dns: '223.5.5.5:53'
    check_interval: 60s
    check_tolerance: 50ms
    # DNS 上游写域名时用它自举；写死 IP 时不会用到。
    bootstrap_resolver: '1.1.1.1:53'
    store_subscribe: true
    nfqueue_enable: true
}

experimental {
    native_api {
        enabled: true
        # DOONA 改为 LAN 可达（默认 127.0.0.1 远程只能走 SSH 隧道）；
        # 有 password_auth 兜底。注意：自定义 config.dae 属 file-owned，
        # control.sh settings 拒绝改 runtime 字段——监听地址只能改这里 + restart
        listen: '0.0.0.0:9527'
        password_auth: true
        allow_anonymous_loopback: false
        config_write: true
        ui: '/usr/share/doona'
    }

    clash_api {
        external_controller: '0.0.0.0:9090'
        external_ui: '/usr/share/honk/zashboard'
        secret: 'CHANGE_ME_RANDOM'
        default_mode: Rule
    }

    # 缓存解析结果与订阅，重启后首包更快。
    cache_file {
        enabled: true
    }
}

subscription {
    # Sub-Store 统一入口的每 VPS 单订阅导出；订阅 tag 即池身份（subtag 过滤，
    # 节点改名/随机后缀不影响分组）。nosla 不订阅自动绝迹
    raksmart: 'https://substore.example.top/TOKEN/download/raksmart' {
        # 直连拉取：冷启动无可用节点时订阅经 proxy 组会死锁；
        # substore 灰云直连家宽可达（2026-11-20 实测 200/0.44s）
        route: direct
    }
    lightlayer: 'https://substore.example.top/TOKEN/download/lightlayer' {
        route: direct
    }
    bitsflow: 'https://substore.example.top/TOKEN/download/bitsflow' {
        route: direct
    }
}

group {
    # us：美国优化线池（raksmart+lightlayer），premium 的默认承载
    us {
        filter: subtag(raksmart)
        filter: subtag(lightlayer)
        policy: min_moving_avg
        tolerance: 50
    }
    # jp：日本低延迟线池（bitsflow），配额不足时的备选
    jp {
        filter: subtag(bitsflow)
        policy: min_moving_avg
        tolerance: 50
    }
    # 日常代理：score 先行（不稳回退 min_moving_avg 只需改这一行）
    # 注意：group(...) 必须独占整个 filter 行；多行 filter 之间是 OR
    proxy {
        filter: group(us)
        filter: group(jp)
        policy: score
    }
    # AI/质量敏感：selector，quota-switch.sh 按 komari 月度配额切 us|jp；
    # 切换用 clash API PUT（honk-core proxy 子命令不接受嵌套组成员）
    premium {
        filter: group(us)
        filter: group(jp)
        policy: fixed
        default: us
    }
    # fallback DoH 承载：跨 VPS（us+jp 全池）+ 协议多样（reality+hysteria2）
    doh {
        filter: group(us)
        filter: group(jp)
        policy: min_moving_avg
    }
}

dns {
    # 直连查询带上客户端网段，国内 CDN 才会返回就近地址
    client_subnet: auto
    ipversion_prefer: 4
    use_host: true
    upstream {
        alidns: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
        # 1.1.1.1:443 国内直连受干扰，钉到 doh 组（routing 里 dip 规则双保险）
        cloudflaredns: 'https://1.1.1.1/dns-query?tls_server_name=cloudflare-dns.com' -> doh
    }
    routing {
        request {
            # 本地/DHCP 主机名按原目的地送 dnsmasq
            qname(geosite: private) -> asis
            qname(geosite: cn) -> alidns
            # 自建域名（节点入口/Headscale 等）直连解析，防 doh 承载组全灭时连坐
            qname(suffix: example.top) -> alidns
            fallback: cloudflaredns
        }
        response {
            upstream(cloudflaredns) -> accept
            qname(geosite: private) -> accept
            ip(geoip: cn) -> accept
            fallback: cloudflaredns
        }
    }
}

routing {
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    # 其它代理核心和 DNS 守护进程的出站不能再被抓一次，否则成环。
    pname(AdGuardHome, mosdns, mihomo, sing-box, clash, frpc, xray, v2ray) -> direct(must)
    # BT 走代理既费流量又拖慢节点。
    pname(qbittorrent) -> direct(must)
    dscp(4) -> direct(must)
    # dnsmasq 用 127.0.0.1 源地址查上游，private 规则兜不住，单独放行。
    pname(dnsmasq) && l4proto(udp) && dport(53) -> direct(must)

    # ---- tailnet 保命（运维 SSH 就走这条路径，宁多勿少）----
    # 家庭宽带 UDP 可用，tailscale 全量直连（对齐 passwall2 时代 PriorDirect 语义）；
    # 公司侧的 tailscale-ctrl/tailscale-derp 锁出口组在家庭场景不需要。
    # 100.100.100.100 = MagicDNS；fd7a:115c:a1e0::/48 = tailnet v6 ULA
    pname(tailscaled) -> direct(must)
    dip(100.64.0.0/10, 100.100.100.100/32, 'fd7a:115c:a1e0::/48') -> direct(must)
    # 直连对穿的 WireGuard 外层 UDP（tailscaled 以监听口 41641 为源端口）
    l4proto(udp) && sport(41641) -> direct(must)

    # ---- STUN 直连（LAN 客户端 + 路由器自身 NAT 穿越）----
    l4proto(udp) && dport(3478) -> direct

    # ---- 自建节点入口精确直连（只匹配 IP+协议+端口，勿整台 VPS /32）----
    # 203.0.113.10 = raksmart、203.0.113.20 = lightlayer、203.0.113.30 = bitsflow
    dip(203.0.113.10/32) && l4proto(udp) && dport(51197) -> direct(must)
    dip(203.0.113.20/32) && l4proto(udp) && dport(36143) -> direct(must)
    dip(203.0.113.30/32) && l4proto(udp) && dport(47625) -> direct(must)
    # hy2 固定口回程
    sip(203.0.113.10/32) && l4proto(udp) && sport(51197) -> direct(must)
    sip(203.0.113.20/32) && l4proto(udp) && sport(36143) -> direct(must)
    sip(203.0.113.30/32) && l4proto(udp) && sport(47625) -> direct(must)
    # hy2 端口跳跃段（双向放行，漏掉会落入 fallback: proxy 形成代理回环）
    dip(203.0.113.10/32, 203.0.113.20/32, 203.0.113.30/32) && l4proto(udp) && dport(48000-50000) -> direct(must)
    sip(203.0.113.10/32, 203.0.113.20/32, 203.0.113.30/32) && l4proto(udp) && sport(48000-50000) -> direct(must)

    # ---- cloudflared tunnel（路由器本机容器，必须直连）----
    domain(suffix: argotunnel.com, suffix: cftunnel.com, suffix: cloudflareaccess.com) -> direct(must)
    dip(198.41.192.0/24, 198.41.200.0/24) && l4proto(tcp) && dport(7844) -> direct(must)
    dip(198.41.192.0/24, 198.41.200.0/24) && l4proto(udp) && dport(7844) -> direct(must)

    # ---- Google / Gemini 显式代理（先于 CN 直连）----
    domain(geosite:google-deepmind, geosite:google) -> proxy

    # ---- fallback DoH 上游钉到 doh 组 ----
    # dip 打底：IP 形式拨号无 SNI，domain 规则匹配不到；104.16.248-249.x 为
    # cloudflare-dns.com 固定 A 记录兜底；domain 覆盖 A 记录漂移与浏览器自带 DoH
    dip(1.1.1.1/32, 1.0.0.1/32, 104.16.248.249/32, 104.16.249.249/32) -> doh
    domain(suffix: cloudflare-dns.com) -> doh

    # ---- Reality TCP 443 节点入口直连 ----
    # 与同机 Web 共用 443：带 SNI 的流量已被上面域名规则接走，剩余裸 IP 直连
    # 的才是节点入口。因此不放到更前面的规则段。
    dip(203.0.113.10/32, 203.0.113.20/32, 203.0.113.30/32) && l4proto(tcp) && dport(443) -> direct(must)

    # 路由器自身地址直连，管理面板不被代理；服务启动时按本机地址重写下面区块
    # honk:local-direct-begin
    # honk:local-direct-end
    dip(geoip: private) && !dport(53) -> direct(must)
    dip(geoip: cn) && !dport(53) -> direct(must)
    domain(geosite: private) -> direct
    domain(geosite: cn) -> direct
    # 这几类在 geosite: cn 里覆盖不全，单独列出
    domain(geosite: apple-cn) -> direct
    domain(geosite: category-games@cn) -> direct
    domain(geosite: steam@cn) -> direct
    domain(geosite: category-ai-cn) -> direct
    domain(geosite: onedrive) -> direct

    # ---- premium 特例（先于 fallback）----
    domain(geosite:openai, geosite:anthropic, geosite:paypal) -> premium

    # 前面全是直连，未命中的就是国外流量，进代理组。
    fallback: proxy
}
