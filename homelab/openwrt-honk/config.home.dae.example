# ============================================================
# router-home 的 honk 配置（脱敏模板）— 2026-11-25 12:14 起线上的方案
# 大白话的架构说明见同目录 README.md「配置架构」；部署记录与流程见「部署流程与 2026-11-25 部署记录」
#
# 这是唯一来源，不要直接编辑：改完本文件后运行
#   python3 tools/honk_subs.py --candidate /tmp/config.dae
# 它代入路由器上的真实值生成完整配置（0600）并审计。带密钥的文件不进仓库。
#
# 占位符：
#   - 203.0.113.10  -> raksmart 公网 IP
#   - 203.0.113.20  -> lightlayer 公网 IP
#   - 203.0.113.40  -> lightlayer-zh 公网 IP
#   - 203.0.113.30  -> bitsflow 公网 IP
#   - example.top   -> 自建域名后缀
#   - TOKEN         -> Sub-Store 路径 token
#   - CHANGE_ME_RANDOM -> clash API 随机密钥（勿留空：默认 0.0.0.0 无鉴权暴露）
#   - honk:local-direct-begin/end 之间的一行由 control.sh 在服务启动时重渲染
# 节点段每个块的首行写成「# <订阅名> <占位 IP>」，--candidate 据此按订阅实际内容代入真实 IP。
#
# 实装踩坑记录（勿再踩）：
#   1. 池身份一律用 subtag(<订阅tag>)，勿依赖节点名；name('正则') 是全匹配语义
#   2. 订阅必须 route: direct，否则冷启动无节点时订阅下载死锁
#   3. 改配置用 `honk-core reload`（热重载）；`/etc/init.d/honk reload` 实为 restart，会断连接
#   4. clash_api secret / native_api listen 改动热 reload 不生效，需 lifecycle restart
#   5. `honk-core config validate` 查不出 subtag(...) / group(...) 的引用错误（实测两种都
#      通过）：subtag 写错 = 运行时静默空过滤；group 写错 = 热重载被拒（旧配置继续生效），
#      但拿它直接 restart 会让核心起不来。改完一律先 `honk-core reload`，通过后再谈 restart
#   6. 组里一条 filter 都不剩 = 接收全部节点；删订阅时别把某组最后一行 filter 删掉
#   7. group(...) 必须独占整个 filter 行；切 selector 用 clash API PUT /proxies/<组>
#   8. 兜底别用 fallback 策略：它一旦顺延就粘在备胎上，首选恢复了也不切回。
#      用「selector 默认首选 + 各组 final 逐级兜底」，首选恢复后自动切回
# ============================================================

global {
    wan_interface: auto
    lan_interface: 'br-lan'
    log_level: info
    dial_mode: domain
    allow_insecure: false
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk'
    # 默认只走 logread，由面板日志页读取。需要跨重启排障时再指定持久路径。
    log_file: ''
    # 检测目标与公司侧对齐：cp.cloudflare.com（gstatic 有 geoip:cn 误杀前科）、
    # AliDNS:53（VPS 侧 Xray 有对应的 UDP53 窄例外，见 vps-proxy-rollout/ROUTING.md）
    tcp_check_url: 'http://cp.cloudflare.com'
    tcp_check_http_method: HEAD
    udp_check_dns: '223.5.5.5:53'
    check_interval: 60s
    check_tolerance: 50ms
    # 自举解析器：节点入口域名（hy2 节点的 server 是域名）、route: direct 的订阅下载
    # 都走它，不经 honk 的 DNS 路由，所以 DNS 上游写死 IP 也照样用到。用国内解析器，
    # 免得这些查询明文跨境；留空或查询失败时回落 /etc/hosts 与系统 nameserver。
    bootstrap_resolver: '223.5.5.5:53'
    store_subscribe: true
    nfqueue_enable: true
}

experimental {
    native_api {
        enabled: true
        # DOONA 改为 LAN 可达（默认 127.0.0.1 远程只能走 SSH 隧道）；
        # 有 password_auth 兜底。注意：自定义 config.dae 属 file-owned，
        # control.sh settings 拒绝改 runtime 字段——监听地址只能改这里 + restart
        listen: '0.0.0.0:9527'
        password_auth: true
        allow_anonymous_loopback: false
        config_write: true
        ui: '/usr/share/doona'
    }

    clash_api {
        external_controller: '0.0.0.0:9090'
        external_ui: '/usr/share/honk/zashboard'
        secret: 'CHANGE_ME_RANDOM'
        default_mode: Rule
    }

    # 缓存解析结果与订阅，重启后首包更快。
    cache_file {
        enabled: true
    }
}

subscription {
    # Sub-Store 统一入口的每 VPS 单订阅导出；订阅 tag 即 VPS 身份（见 group 的 subtag 过滤）。
    # 各订阅相互独立：某条拉取失败 / 404 / 解析失败时，honk 保留该订阅上一次的有效节点
    # （日志 "Subscription refresh failed; keeping active nodes"），其余订阅不受影响；
    # 冷启动先从 state/honk.db 恢复各订阅正文，再后台刷新。
    # 直连拉取：冷启动无可用节点时订阅经 proxy 组会死锁。
    # substore 域名是 Cloudflare 橙云（解析到 104.21.x / 172.67.x），家宽直连偶发
    # download_timeout 属正常，失败后 30s 起指数退避重试（上限 min(10min, interval)）。
    raksmart: 'https://substore.example.top/TOKEN/download/raksmart' {
        route: direct
    }
    lightlayer: 'https://substore.example.top/TOKEN/download/lightlayer' {
        route: direct
    }
    lightlayer-zh: 'https://substore.example.top/TOKEN/download/lightlayer-zh' {
        route: direct
    }
    bitsflow: 'https://substore.example.top/TOKEN/download/bitsflow' {
        route: direct
    }
}

group {
    # ============ 每台 VPS 一个组 ============
    # 组内是该 VPS 的两个节点（Reality / Hy2），自动用延迟低的那个活着的。
    # final = 这一整台都不通时改用哪个组（逐级往下兜底）。
    # 一台 VPS 一行 filter；删 VPS 时同步删（删到一行 filter 都不剩，本组会变成"全部节点"）。

    # lightlayer-zh：AI 首选。整台不通 → us
    lightlayer-zh {
        filter: subtag(lightlayer-zh)
        policy: min_moving_avg
        tolerance: 50
        final: us
    }
    # us：raksmart（暂时还有待退役的 lightlayer）。整台不通 → jp
    us {
        filter: subtag(raksmart)
        filter: subtag(lightlayer)
        policy: min_moving_avg
        tolerance: 50
        final: jp
    }
    # jp：bitsflow
    jp {
        filter: subtag(bitsflow)
        policy: min_moving_avg
        tolerance: 50
    }

    # ============ 按用途选 VPS 的三个组 ============
    # 日常流量：raksmart 与 bitsflow 之间按实际体验自动选（score）。lightlayer-zh 不参与。
    proxy {
        filter: group(us)
        filter: group(jp)
        policy: score
    }
    # AI 流量：首选 lightlayer-zh；它整台不通时依次顺延到 raksmart、bitsflow；
    # 恢复后自动切回。可在面板里手动选，或由 quota-switch.sh 按流量配额切到 us。
    # us、jp 既是备选成员，也保证这个组在 lightlayer-zh 挂掉时不会被整体判为不可用。
    premium {
        filter: group(lightlayer-zh)
        filter: group(us)
        filter: group(jp)
        policy: fixed
        default: lightlayer-zh
    }
    # 国外域名解析（DoH）的通道：raksmart / bitsflow 里延迟低的那个；
    # 两台都不通才用 lightlayer-zh（DNS 流量极小，不影响它的配额）。
    doh {
        filter: group(us)
        filter: group(jp)
        policy: min_moving_avg
        final: lightlayer-zh
    }
}

dns {
    # ECS：auto 探测首个公网网关跳，用它的 /24 作为客户端网段附给直连上游（家宽是
    # CGNAT，拿不到真实客户端公网段）。对国内 CDN 就近帮助有限，保留无害
    client_subnet: auto
    ipversion_prefer: 4
    use_host: true
    upstream {
        alidns: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
        # 1.1.1.1:443 国内直连受干扰，钉到 doh 组（routing 里 dip 规则双保险）
        cloudflaredns: 'https://1.1.1.1/dns-query?tls_server_name=cloudflare-dns.com' -> doh
    }
    routing {
        request {
            # 本地/DHCP 主机名按原目的地送 dnsmasq
            qname(geosite: private) -> asis
            qname(geosite: cn) -> alidns
            # 自建域名（节点入口/Headscale 等）直连解析，防 doh 承载组全灭时连坐
            qname(suffix: example.top) -> alidns
            fallback: cloudflaredns
        }
        response {
            upstream(cloudflaredns) -> accept
            qname(geosite: private) -> accept
            ip(geoip: cn) -> accept
            fallback: cloudflaredns
        }
    }
}

routing {
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    # 其它代理核心和 DNS 守护进程的出站不能再被抓一次，否则成环。
    pname(AdGuardHome, mosdns, mihomo, sing-box, clash, frpc, xray, v2ray) -> direct(must)
    # BT 走代理既费流量又拖慢节点。
    pname(qbittorrent) -> direct(must)
    dscp(4) -> direct(must)
    # dnsmasq 用 127.0.0.1 源地址查上游，private 规则兜不住，单独放行。
    # 副作用：路由器自身经 127.0.0.1 的解析走运营商明文 DNS（国外域名被污染），
    # LAN 客户端不受影响（53 端口在 br-lan 入口被 honk 接管）。
    pname(dnsmasq) && l4proto(udp) && dport(53) -> direct(must)

    # ---- tailnet 保命（运维 SSH 就走这条路径，宁多勿少）----
    # 家庭宽带 UDP 可用，tailscale 全量直连（对齐 passwall2 时代 PriorDirect 语义）；
    # 公司侧的 tailscale-ctrl/tailscale-derp 锁出口组在家庭场景不需要。
    # 100.100.100.100 = MagicDNS；fd7a:115c:a1e0::/48 = tailnet v6 ULA
    pname(tailscaled) -> direct(must)
    dip(100.64.0.0/10, 100.100.100.100/32, 'fd7a:115c:a1e0::/48') -> direct(must)
    # 直连对穿的 WireGuard 外层 UDP（tailscaled 以监听口 41641 为源端口）
    l4proto(udp) && sport(41641) -> direct(must)

    # ---- STUN 直连（LAN 客户端 + 路由器自身 NAT 穿越）----
    l4proto(udp) && dport(3478) -> direct

    # ---- LAN 客户端设备的 Tailscale 直连（2026-11-21）----
    # 路由器自身已由上方 pname(tailscaled) 覆盖；这两条保护 LAN 里运行
    # Tailscale 的设备（PC/手机）：官方 DERP 与控制域名不再落入
    # fallback: proxy，透明代理停摆时客户端 tailnet 兜底不受连累
    # （公司侧 2026-11-20 停机演练教训）。full 精确匹配控制域名，
    # 避免误伤 substore 等其它自建子域
    domain(suffix: tailscale.com) -> direct
    domain(full: hs.example.top) -> direct

    # ---- 自建节点入口直连（只匹配 IP+协议+端口，勿整台 VPS /32）----
    # 作用：LAN 里自带代理客户端的设备直连节点时，不再被 honk 套一层代理（套娃/回环）。
    # honk 自己拨节点走旁路 mark，不依赖这些规则。
    # 每台 VPS 一个 5 行块：hy2 固定口 dip/sip、跳跃段 48000-50000 dip/sip、Reality TCP 443。
    # 增删 VPS = 整块增删；块首行必须是「# <订阅名> <占位 IP>」，见文件头。
    # --candidate 会对照订阅实际内容审计这一段：漏规则、端口不对都会报出来。
    # 443 整口直连：既是 Reality 入口，也让访问同机面板/服务不绕代理（免经节点回连自身）。
    # honk:nodes-begin
    # raksmart 203.0.113.10（hy2 固定口 51197）
    dip(203.0.113.10/32) && l4proto(udp) && dport(51197) -> direct(must)
    sip(203.0.113.10/32) && l4proto(udp) && sport(51197) -> direct(must)
    dip(203.0.113.10/32) && l4proto(udp) && dport(48000-50000) -> direct(must)
    sip(203.0.113.10/32) && l4proto(udp) && sport(48000-50000) -> direct(must)
    dip(203.0.113.10/32) && l4proto(tcp) && dport(443) -> direct(must)

    # lightlayer 203.0.113.20（hy2 固定口 36143）
    dip(203.0.113.20/32) && l4proto(udp) && dport(36143) -> direct(must)
    sip(203.0.113.20/32) && l4proto(udp) && sport(36143) -> direct(must)
    dip(203.0.113.20/32) && l4proto(udp) && dport(48000-50000) -> direct(must)
    sip(203.0.113.20/32) && l4proto(udp) && sport(48000-50000) -> direct(must)
    dip(203.0.113.20/32) && l4proto(tcp) && dport(443) -> direct(must)

    # lightlayer-zh 203.0.113.40（hy2 固定口 15672）
    dip(203.0.113.40/32) && l4proto(udp) && dport(15672) -> direct(must)
    sip(203.0.113.40/32) && l4proto(udp) && sport(15672) -> direct(must)
    dip(203.0.113.40/32) && l4proto(udp) && dport(48000-50000) -> direct(must)
    sip(203.0.113.40/32) && l4proto(udp) && sport(48000-50000) -> direct(must)
    dip(203.0.113.40/32) && l4proto(tcp) && dport(443) -> direct(must)

    # bitsflow 203.0.113.30（hy2 固定口 47625）
    dip(203.0.113.30/32) && l4proto(udp) && dport(47625) -> direct(must)
    sip(203.0.113.30/32) && l4proto(udp) && sport(47625) -> direct(must)
    dip(203.0.113.30/32) && l4proto(udp) && dport(48000-50000) -> direct(must)
    sip(203.0.113.30/32) && l4proto(udp) && sport(48000-50000) -> direct(must)
    dip(203.0.113.30/32) && l4proto(tcp) && dport(443) -> direct(must)
    # honk:nodes-end

    # ---- cloudflared tunnel（路由器本机容器，必须直连）----
    domain(suffix: argotunnel.com, suffix: cftunnel.com, suffix: cloudflareaccess.com) -> direct(must)
    dip(198.41.192.0/24, 198.41.200.0/24) && l4proto(tcp) && dport(7844) -> direct(must)
    dip(198.41.192.0/24, 198.41.200.0/24) && l4proto(udp) && dport(7844) -> direct(must)

    # ---- AI 服务：走 premium（lightlayer-zh 首选，挂了顺延）----
    # 必须排在下面的 Google 规则前面：Gemini 的域名全在 geosite:google 里，放在后面会先被
    # Google 规则接走。这几个分类与 geosite:cn 没有重叠。扩展 AI 清单时用分类、别用全量
    # category-ai-!cn（它混着 HuggingFace、Cursor 更新等下载类域名，会消耗 lightlayer-zh 的流量）。
    domain(geosite:openai, geosite:anthropic, geosite:google-gemini, geosite:xai, geosite:perplexity) -> premium

    # ---- Google 系显式代理（先于 CN 直连）----
    domain(geosite:google) -> proxy

    # ---- fallback DoH 上游钉到 doh 组 ----
    # dip 打底：IP 形式拨号无 SNI，domain 规则匹配不到；104.16.248-249.x 为
    # cloudflare-dns.com 固定 A 记录兜底；domain 覆盖 A 记录漂移与浏览器自带 DoH
    dip(1.1.1.1/32, 1.0.0.1/32, 104.16.248.249/32, 104.16.249.249/32) -> doh
    domain(suffix: cloudflare-dns.com) -> doh

    # 路由器自身地址直连，管理面板不被代理；服务启动时按本机地址重写下面区块
    # honk:local-direct-begin
    # honk:local-direct-end
    dip(geoip: private) && !dport(53) -> direct(must)
    dip(geoip: cn) && !dport(53) -> direct(must)
    domain(geosite: private) -> direct
    domain(geosite: cn) -> direct
    # 这几类在 geosite: cn 里覆盖不全，单独列出
    domain(geosite: apple-cn) -> direct
    domain(geosite: category-games@cn) -> direct
    domain(geosite: steam@cn) -> direct
    domain(geosite: category-ai-cn) -> direct
    domain(geosite: onedrive) -> direct

    # ---- PayPal 等出口质量敏感（先于 fallback）----
    domain(geosite:paypal) -> premium

    # 前面全是直连，未命中的就是国外流量，进代理组。
    fallback: proxy
}
