# Operational secrets and state; never commit these.
*.state
*.sqlite
*.sqlite-shm
*.sqlite-wal
*authkey*
*preauth*
*privkey*
*.pem
*.key

# Test fixtures are inert fakes; allow the fixture identity marker by exact path.
!tests/fixtures/openwrt/etc/tailscale/tailscaled.state

# Generated private snapshots and test output.  Curated device snapshots
# under backups/<device>/ are committed deliberately: the repo MUST stay
# private because they contain real node credentials.
backups/*
!backups/gl-mt3600be/
!backups/gl-mt3600be/20261027-selfcarry/
tests/tmp/
**/.INCOMPLETE
**/manifest.sha256

